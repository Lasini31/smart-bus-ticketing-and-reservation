  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "LOGIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Check login succeeded\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "// Save token and userId to collection variables\r",
                  "if (response.token) {\r",
                  "    pm.collectionVariables.set(\"authToken\", response.token);\r",
                  "    pm.collectionVariables.set(\"userId\", response.userId);\r",
                  "    console.log(\"✅ Token saved successfully\");\r",
                  "    console.log(\"✅ User ID saved: \" + response.userId);\r",
                  "} else {\r",
                  "    console.log(\"❌ Login failed - no token in response\");\r",
                  "}\r",
                  "\r",
                  "// Basic test checks\r",
                  "pm.test(\"Status is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has token\", function () {\r",
                  "    pm.expect(response.token).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has role\", function () {\r",
                  "    pm.expect(response.role).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has userId\", function () {\r",
                  "    pm.expect(response.userId).to.exist;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"oshanimaduwage@hotmail.com\",\r\n    \"password\": \"password123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
